# Copy this file to .env and fill in a key. Never commit .env itself.
# You only need ONE provider. With no key at all, the system runs in offline mode.

# Option 1 (free): Google Gemini. Get a key at https://aistudio.google.com
#GEMINI_API_KEY=your-key-here
# Optional: model id exactly as listed in AI Studio (default: gemini-3.5-flash)
# ADS_MODEL=gemini-3.5-flash
# Optional: minimum seconds between live calls (default 4 for Gemini, protects the free-tier limit)
# ADS_MIN_INTERVAL=4

# Option 2 (paid): Anthropic
# ANTHROPIC_API_KEY=your-key-here

# Optional: force a provider when both keys are set (gemini | anthropic)
# ADS_PROVIDER=gemini
